#!/usr/bin/env bash

set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

if (($# == 0)); then
  echo "Usage: $0 [stow options] <package>..." >&2
  echo "Available packages:" >&2
  for package in "$root"/packages/*/; do
    echo "  $(basename "$package")" >&2
  done
  exit 2
fi

exec stow \
  --no-folding \
  --dir="$root/packages" \
  --target="$HOME" \
  --ignore='\.DS_Store' \
  "$@"
